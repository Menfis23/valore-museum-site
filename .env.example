# Keep this file private. Never commit it or share it.

ANTHROPIC_API_KEY=
ARC_ANTHROPIC_MODEL=claude-opus-4-8

# Postgres connection string. Create a dedicated database first (e.g. "valore_museum")
# so this project's data stays separate from any other project's database.
POSTGRES_DSN=

# Admin moderation queue login (HTTP Basic Auth).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: n8n webhook URL — see n8n/valore-museum-moderation.json.
N8N_WEBHOOK_URL=
N8N_CALLBACK_SECRET=

DISABLE_BUILTIN_AI_SCREENING=false
MUSEUM_PORT=8899
